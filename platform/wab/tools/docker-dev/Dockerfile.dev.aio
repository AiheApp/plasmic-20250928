# --- Build stage ---
# Node pinned to 24.16.0: Node 24.17.0 has an http.Agent keep-alive regression
# (nodejs/node#63989) that breaks node-fetch outbound requests. Same pin as
# upstream platform/wab/Dockerfile.
FROM node:24.16.0-alpine AS builder

WORKDIR /plasmic

# Install system deps
RUN apk add --no-cache \
    bash \
    git \
    curl \
    wget \
    python3 \
    py3-pip \
    postgresql-client \
    build-base

# Skip Playwright Chromium download — runtime container only runs the dev
# server, not Playwright tests. Saves ~150 MB during builder + ~500 MB unpacked.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Copy all source files first (needed for the pnpm workspace)
COPY . .

# Root workspace is pnpm since upstream #2939 (root yarn.lock removed;
# packageManager: pnpm@11.8.0). Platform sub-dirs (wab, sub, …) still use yarn:
# enable ONLY the pnpm corepack shim (a yarn shim would strict-refuse under the
# root's packageManager field), and skip classic yarn 1.22's own corepack check,
# which walks up from platform/* to the root package.json and errors.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    SKIP_YARN_COREPACK_CHECK=1
RUN corepack enable pnpm && corepack prepare pnpm@11.8.0 --activate

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Secrets setup and build tools
# NOTE: must be `pnpm run setup` — bare `pnpm setup` hits pnpm's builtin command.
RUN mkdir -p /tmp/.plasmic && \
    cp platform/wab/tools/docker-dev/secrets.json /tmp/.plasmic/secrets.json && \
    pnpm run setup && \
    pnpm run setup:canvas-packages

# Install dependencies for all sub-packages used by dev server
RUN cd platform/sub && yarn && \
    cd ../canvas-packages && yarn && \
    cd ../react-web-bundle && yarn && \
    cd ../live-frame && yarn && \
    cd ../loader-html-hydrate && yarn

# Strip caches, test files, docs, and source maps before the layer is committed
# so the deletions actually shrink the image (rather than being shadowed by a
# later layer). Single RUN keeps it all in one layer.
# Conservative deletions only — do not touch .bin, dist, lib, build, or @types.
RUN yarn cache clean && \
    (pnpm store prune 2>/dev/null || true) && \
    rm -rf /root/.npm /root/.cache /root/.yarn /root/.local/share/pnpm /tmp/* 2>/dev/null || true && \
    find /plasmic -type d \( \
        -name "__tests__" -o \
        -name "test" -o \
        -name "tests" -o \
        -name ".storybook" -o \
        -name "storybook-static" -o \
        -name "coverage" -o \
        -name ".nyc_output" \
      \) -prune -exec rm -rf {} + 2>/dev/null || true && \
# NOTE: test/spec deletion is scoped to first-party source via -not -path
# "*/node_modules/*". A blanket "*.test.js" delete inside node_modules nukes
# legitimately-named package files (e.g. core-js/modules/es.regexp.test.js),
# which breaks require('core-js/full') and crashes the backend.
    find /plasmic -type f -not -path "*/node_modules/*" \( \
        -name "*.test.js" -o \
        -name "*.test.ts" -o \
        -name "*.test.tsx" -o \
        -name "*.spec.js" -o \
        -name "*.spec.ts" -o \
        -name "*.spec.tsx" \
      \) -delete 2>/dev/null || true && \
    find /plasmic -type f \( \
        -name "*.map" -o \
        -name "CHANGELOG.md" -o \
        -name "HISTORY.md" \
      \) -delete 2>/dev/null || true && \
    find /plasmic -path "*/node_modules/*" -type f \( \
        -name "*.md" -o \
        -name "*.markdown" -o \
        -name "LICENSE" -o \
        -name "LICENSE.txt" \
      \) -delete 2>/dev/null || true

# --- Final stage ---
# Same Node pin as the builder stage (nodejs/node#63989 keep-alive regression).
FROM node:24.16.0-alpine

# Create non-root user and prepare env
RUN addgroup -S plasmic && \
    adduser -S plasmic -G plasmic && \
    apk add --no-cache git jq bash postgresql-client && \
    mkdir -p /home/plasmic && \
    chown -R plasmic:plasmic /home/plasmic

USER plasmic

WORKDIR /plasmic/platform/wab

# Copy built app and secrets with correct ownership
COPY --chown=plasmic:plasmic --from=builder /plasmic /plasmic
COPY --chown=plasmic:plasmic --from=builder /tmp/.plasmic /home/plasmic/.plasmic

# Fix git ownership check issue (required for rsbuild config)
RUN git config --global --add safe.directory /plasmic

EXPOSE 3003 3004 3005

ENTRYPOINT ["sh", "-c"]
CMD ["chmod +x /plasmic/platform/wab/tools/docker-dev/ensure-db.sh && \
    /plasmic/platform/wab/tools/docker-dev/ensure-db.sh && \
    jq '(.host = \"plasmic-db\") | (.password //= \"SEKRET\")' ormconfig.json > tmp.json && mv tmp.json ormconfig.json && \
    yarn typeorm migration:run && \
    yarn seed && \
    cd /plasmic && \
    yarn dev \
"]